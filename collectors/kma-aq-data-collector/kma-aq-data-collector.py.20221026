#!/usr/bin/env python3

#-------------------------------------------------------------------
# KMA Air Quality Data Collector [Python3/TAB]
#
# yskwon, 2020-05-26
#-------------------------------------------------------------------

import json
import signal
import sys
import time
import traceback
from datetime import datetime

import pymysql.cursors
import requests
import urllib3
import schedule
from rediscluster import RedisCluster


# Global constants
CONFIG_FILE = "/opt/apps/apps-config.json"
HTTP_TIMEOUT = (10, 58)     # (connection_timeout, read_timeout)
MYSQL_DEFAULT_FETCH_ROWS = 10

PSEUDO_SERVICE_ID = "kma-aq"
REDIS_CHANNEL_NAME = "kma/weather/dong/aq"

KMA_AQ_METRIC_PREFIX = "kma-aq"
KMA_AQ_SENSOR_FIELDS = [
	{ "field": "pm10_value", "sensor_name": "pm10" },
	{ "field": "pm10_grade", "sensor_name": "pm10_grade" },
	{ "field": "pm25_value", "sensor_name": "pm25" },
	{ "field": "pm25_grade", "sensor_name": "pm25_grade" }
]

urllib3.disable_warnings()

# Load configurations and start a redis cluster client
try:
	with open(CONFIG_FILE, 'r') as f:
		conf = json.load(f)

	# MySQL
	address = conf["servers"]["kwKiotCluster"]["mysql"]["address"][0].split(":")
	username = conf["servers"]["kwKiotCluster"]["mysql"]["username"]
	password = conf["servers"]["kwKiotCluster"]["mysql"]["password"]

	mysql_connection = pymysql.connect(host=address[0], port=int(address[1]),
		user=username, password=password, db="re_kiot", charset='utf8mb4',
		cursorclass=pymysql.cursors.DictCursor, autocommit=False)

	# Redis
	redis_startup_nodes = []
	for address in conf["servers"]["kwKiotCluster"]["redis"]["address"][0].split(","):
		address = address.split(":")
		redis_startup_nodes.append({"host": address[0], "port": address[1]})

	rc = RedisCluster(startup_nodes=redis_startup_nodes, decode_responses=True,
		password=conf["servers"]["kwKiotCluster"]["redis"]["password"])

	redis_ir_channel = conf["collector"]["redis"]["dataChannelV1"]["get"] + REDIS_CHANNEL_NAME

	# OpenTSDB WO
	s = requests.Session()
	# In a multithreaded environment, pool_maxsize must be increased
	s.mount("http://",
		requests.adapters.HTTPAdapter(pool_connections=1, pool_maxsize=1))

	tsdb_query_url = "http://" + conf["servers"]["kwKiotCluster"]["opentsdbWo"]["address"][0] + "/api/put"

	# Default last_updated_datetime (every 10 minutes)
	timestamp = (int(time.time()/600))*600
	last_updated_datetime = datetime.fromtimestamp(timestamp).strftime("%Y%m%d%H%M")
	print(f"INFO: Set default lastUpdatedDatetime: {last_updated_datetime}-{timestamp}")

except Exception:
	traceback.print_exc()
	sys.exit(1)


def receive_signal(signal_number, frame):
	print("Received signal: " + str(signal_number))
	sys.exit()


def release():
	print("Disconnected from all servers and released all resources")
	mysql_connection.close()
	s.close()


def send_to_tsdb(rows):
	global timestamp
	queries = []

	for row in rows:
		metric = f"{KMA_AQ_METRIC_PREFIX}.{row['dcode']}"

		for sensor in KMA_AQ_SENSOR_FIELDS:
			queries.append({
				"metric": metric,
				"timestamp": timestamp,
				"value": row[sensor["field"]],
				"tags": {
					"map_type": row["map_type"],
					"sensor": sensor["sensor_name"]
				}
			})

			queries.append({
				"metric": KMA_AQ_METRIC_PREFIX,
				"timestamp": timestamp,
				"value": row[sensor["field"]],
				"tags": {
					"dcode": row["dcode"],
					"map_type": row["map_type"],
					"sensor": sensor["sensor_name"]
				}
			})

		if row['temp']:
			queries.append({
				"metric": metric,
				"timestamp": timestamp,
				"value": row["temp"],
				"tags": {
					"map_type": row["map_type"],
					"sensor": "temp"
				}
			})

			queries.append({
				"metric": KMA_AQ_METRIC_PREFIX,
				"timestamp": timestamp,
				"value": row["temp"],
				"tags": {
					"dcode": row["dcode"],
					"map_type": row["map_type"],
					"sensor": "temp"
				}
			})
		
		if row['humi']:
			queries.append({
				"metric": metric,
				"timestamp": timestamp,
				"value": row["humi"],
				"tags": {
					"map_type": row["map_type"],
					"sensor": "humi"
				}
			})
			queries.append({
				"metric": KMA_AQ_METRIC_PREFIX,
				"timestamp": timestamp,
				"value": row["humi"],
				"tags": {
					"dcode": row["dcode"],
					"map_type": row["map_type"],
					"sensor": "humi"
				}
			})

	# print(f"INFO: queries= {queries}")
	r = s.post(tsdb_query_url, data=json.dumps(queries), timeout=HTTP_TIMEOUT)
	r.raise_for_status()


def publish_to_redis(rows):
	global timestamp

	ir_data = {
		"service": {
			"id": PSEUDO_SERVICE_ID,
			"timestamp": timestamp
		}
	}

	for row in rows:
		ir_data["service"]["deviceId"] = row["dcode"]
		ir_data["data"] = {}
		for sensor in KMA_AQ_SENSOR_FIELDS:
			ir_data["data"][sensor["sensor_name"]] = row[sensor["field"]]

		if row['temp']:
			ir_data["data"]["temp"] = row["temp"]

		if row['humi']:
			ir_data["data"]["humi"] = row["humi"]


		# print(f"INFO: ir_data= {ir_data}")
		rc.publish(redis_ir_channel, json.dumps(ir_data))

def make_temp(rows, dw_data):
	for row in rows:
		if row['dcode'] in dw_data:
			row['temp'] = dw_data[row['dcode']]['temp']
			row['humi'] = dw_data[row['dcode']]['humi']
		else:
			row['temp'] = None
			row['humi'] = None
			print(f"INFO: row= {row}")


	# print(f"INFO: rows= {rows}")



# Job to be scheduled
def job():
	global timestamp
	global last_updated_datetime

	timestamp = (int(time.time()/600))*600
	last_updated_datetime = datetime.fromtimestamp(timestamp).strftime("%Y%m%d%H%M")
	print(f"INFO: lastUpdatedDatetime: {last_updated_datetime}-{timestamp}")

	# Get Dong Weather Info
	# https://kwapi.kweather.co.kr/v1/kma/shko/currentweather?auth=a3dlYXRoZXItYXBwLWF1dGg=
	dw_data = {}
	try:
		r = s.get('http://kwall5.kweather.co.kr:22001/kma/shko/current', timeout=HTTP_TIMEOUT);

		if r.status_code == 200:
			json_data = r.json()
			for data in json_data['result']:
				# print(data, 'data')
				dw_data[str(data['hangCd'])] = {
					'temp' : data['temp'],
					'humi' : data['humi']
					}

		print(f"dw_data: dw_data={dw_data}")

	except Exception as e:
		print(e)


	# Get Dong Dust Data
	with mysql_connection.cursor() as cursor:
		try:
			sql = "SELECT * FROM `TB_DONG_DUST_DATA`;"
			cursor.execute(sql)
			print(f"SUCCESS: [MYSQL/SELECT]: Found new rows in DB.")

			count = 0
			while True:
				rows = cursor.fetchmany(MYSQL_DEFAULT_FETCH_ROWS)
				if not rows:
					break
				count += len(rows)

				make_temp(rows, dw_data)
				send_to_tsdb(rows)
				publish_to_redis(rows)

			print(f"SUCCESS: [OpenTSDB/PUT][Redis/PUB]: Updated new {count} rows. Last updated = {last_updated_datetime}-{timestamp}")
		except Exception as e:
			print(e)

	mysql_connection.commit()


# Main
if __name__ == '__main__':
	print("Started KMA Air Quality Data Collector.")

	signal.signal(signal.SIGHUP, receive_signal)
	signal.signal(signal.SIGTERM, receive_signal)
	signal.signal(signal.SIGQUIT, receive_signal)

	try:
		job()
		# Schedule a job every 10 minutes
		schedule.every().hour.at(":00").do(job)
		schedule.every().hour.at(":10").do(job)
		schedule.every().hour.at(":20").do(job)
		schedule.every().hour.at(":30").do(job)
		schedule.every().hour.at(":40").do(job)
		schedule.every().hour.at(":50").do(job)
		
		while True:
			schedule.run_pending()
			time.sleep(1)
	except (KeyboardInterrupt, SystemExit):
		print("Stopping KMA Air Quality Data Collector.")
	except Exception:
		traceback.print_exc()
	finally:
		release()
		print("Stopped KMA Air Quality Data Collector.")
